{
  "name": "ff14-collection-notebook",
  "version": "0.1.0",
  "private": true,
  "description": "Personal local collection tracker for FINAL FANTASY XIV minions.",
  "scripts": {
    "test": "node --test tests/*.test.*",
    "start": "node server.js",
    "build:static": "node scripts/build-static-site.js",
    "prune:backups": "node scripts/prune-backups.js",
    "prune:backups:dry-run": "node scripts/prune-backups.js --dry-run",
    "worker:dev": "npx wrangler dev --config workers/lodestone-proxy/wrangler.toml",
    "worker:deploy": "npx wrangler deploy --config workers/lodestone-proxy/wrangler.toml"
  },
  "engines": {
    "node": ">=20"
  }
}
